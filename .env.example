# Public Firebase web config is already in the repo. These server settings are
# optional locally, but durable Vercel writes require a Firebase service account.

FIREBASE_DATABASE_URL=https://mizanoranet-default-rtdb.firebaseio.com
FIREBASE_API_KEY=AIzaSyA4PWELrMHQrRA29EZzfRx1iZkXtJkKh9M

# Vercel → Project → Settings → Environment Variables (Sensitive, all envs).
# Paste the COMPLETE service-account JSON on one line. Never commit this value.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mizanoranet","client_email":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n","token_uri":"https://oauth2.googleapis.com/token"}

# Alternative to the single JSON variable:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-…@mizanoranet.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"

# Strong production overrides (recommended). Sessions/links use the service key
# as a non-public fallback if the two secrets are omitted.
# MZ_OWNER_PIN=replace-with-a-long-private-owner-pin
# MZ_SESSION_SECRET=replace-with-at-least-32-random-characters
# MZ_STREAM_SECRET=replace-with-a-different-32-character-random-string

# Local testing only: use an isolated JSON mirror or require durable writes.
# MZ_RTDB_MIRROR=/tmp/miznaoraiptv-rtdb-mirror.json
# MZ_REQUIRE_PERSISTENCE=1

# Optional dedicated HTTPS media gateway. Leave BOTH unset for direct playback.
# See docs/MEDIA-GATEWAY.md; this worker cannot run on Vercel.
# MZ_GATEWAY_URL=https://media.your-domain.example
# MZ_GATEWAY_SECRET=use-a-separate-private-random-secret-at-least-32-characters
